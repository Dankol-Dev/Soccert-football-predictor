# Backend environment variables
# Copy this file to ".env" and adjust values as needed.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/football_predictor

# Live data via the Supabase Edge Function; provider credentials remain server-side
FOOTBALL_DATA_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/football-data
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT
# Replace with a unique random value (at least 32 characters) outside development.
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — frontend origins allowed to call the API
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
